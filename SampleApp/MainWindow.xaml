<?xml version="1.0" encoding="utf-8" ?>
<controls:ContentWindow
    x:Class="SampleApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SuGarToolkit.WinUI3.Controls.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SampleApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="LayoutRoot"
    Title="SampleApp"
    Width="600"
    Height="450"
    MinWidth="400"
    MinHeight="400"
    ExtendsContentIntoTitleBar="True"
    SizeToContent="True"
    mc:Ignorable="d">

    <controls:ContentWindow.SystemBackdrop>
        <MicaBackdrop />
    </controls:ContentWindow.SystemBackdrop>

    <controls:ContentWindow.Resources>
        <Storyboard x:Name="OpacityStoryboard">
            <DoubleAnimation
                EnableDependentAnimation="True"
                Storyboard.TargetName="LayoutRoot"
                Storyboard.TargetProperty="Width"
                To="0.5"
                Duration="00:00:3" />
        </Storyboard>
    </controls:ContentWindow.Resources>

    <StackPanel x:Name="MainStackPanel">
        <Button
            HorizontalAlignment="Center"
            Content="Use Window like WPF"
            Style="{ThemeResource AccentButtonStyle}" />
        <Button
            HorizontalAlignment="Center"
            Content="Use Window like WPF"
            Style="{ThemeResource SubtleButtonStyle}" />
        <Button
            HorizontalAlignment="Center"
            Click="Button_Click"
            Content="Animate Window" />
        <Rectangle
            x:Name="AnimationTarget"
            Width="100"
            Height="200"
            Fill="Black">
            <Rectangle.Resources>
                <Storyboard x:Name="SizeStoryboard">
                    <DoubleAnimation
                        EnableDependentAnimation="True"
                        Storyboard.TargetName="AnimationTarget"
                        Storyboard.TargetProperty="Width"
                        To="800"
                        Duration="00:00:3" />
                </Storyboard>
            </Rectangle.Resources>
        </Rectangle>
    </StackPanel>

</controls:ContentWindow>
